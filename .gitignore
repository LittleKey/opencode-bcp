# dependencies
node_modules/

# build artifacts (regenerated by scripts/install.sh via bun build)
dist/

# transient scratch from live drills
harness/scratch/
harness/live-agg/

# transient snapshot dumps from verification drills (large artifacts, e.g. 166MB)
snapshot/

# raw run dumps (keep curated acceptance evidence + Phase A probe evidence)
harness/runs/*
!harness/runs/evidence-*.jsonl
.opencode/
.slim/deepwork/

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees
